{
  "harness": {
    "version": "0.48.0"
  },
  "git": {
    "baseBranch": "main",
    "branchPattern": "feature/{task}"
  },
  "verify": {
    "test": "bash hooks/test.sh",
    "$step": {
      "test": "bash hooks/test.sh --since {since}"
    }
  },
  "review": {
    "gatePaths": [
      "skills/sdd-run/scripts/**",
      "hooks/**"
    ]
  }
}
